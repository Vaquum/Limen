      "type": "object",
      "properties": {
        "manifest": {
          "$ref": "#/definitions/manifest"
        },
        "params": {
          "$ref": "#/definitions/params"
        }
      },
      "additionalProperties": false,
      "required": [
        "manifest",
        "params"
      ],
      "allOf": [
        {
          "if": {
            "required": [
              "manifest"
            ],
            "properties": {
              "manifest": {
                "required": [
                  "type"
                ],
                "properties": {
                  "type": {
                    "const": "ml"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "properties": {
                  "use_calibration": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "boolean"
                    }
                  },
                  "use_threshold": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "uel": {
      "$ref": "#/definitions/uel"
    },
    "lineage": {
      "if": {
        "type": "object"
      },
      "then": {
        "type": "object",
        "properties": {
          "id": {},
          "committed_at": {},
          "parent_id": {}
        },
        "additionalProperties": false
      }
    },
    "assessment": {
      "$ref": "#/definitions/assessment"
    },
    "holdout": {
      "$ref": "#/definitions/holdout"
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "metadata",
    "sfd",
    "uel"
