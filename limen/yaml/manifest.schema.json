          "then": {
            "required": [
              "seed"
            ],
            "properties": {
              "type": {
                "const": "sobol"
              },
              "seed": {
                "type": "integer",
                "minimum": 0
              }
            },
            "additionalProperties": false
          }
        },
        {
          "if": {
            "required": [
              "shuffle"
