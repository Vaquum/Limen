{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Limen experiment manifest",
  "description": "Portable structure only. Native Limen admission owns executable references, parameter identity, data evidence and scientific compatibility.",
  "x-limen-package-version": "5.46.2",
  "x-limen-contract-inventory-sha256": "01adf14dab24d4a44af0600fc9208476d0d54f9e0775543a659602cf5d4f81d7",
