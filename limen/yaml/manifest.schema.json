          },
          "then": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "grid"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "shuffle"
            ],
            "properties": {
              "shuffle": {
                "const": true
              }
            }
          },
          "then": {
            "required": [
              "seed"
            ],
            "properties": {
              "seed": {
                "type": "integer"
