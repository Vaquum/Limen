      "allOf": [
        {
          "if": {
            "properties": {
              "on_round_error": {
                "const": "record"
              }
            },
            "required": [
              "on_round_error"
            ]
          },
          "then": {
            "required": [
              "max_round_errors"
            ],
            "properties": {
              "max_round_errors": {
                "type": "integer"
              },
              "workers": {
                "const": 1
              },
              "factorize": {
                "const": false
