{
  "name": "limen-docs-site",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint": "node scripts/lint-docs.mjs && node scripts/check-links.mjs",
    "security:audit": "node ./scripts/audit-security.mjs",
    "start": "node scripts/serve-reader.mjs",
    "build": "node scripts/build-reader.mjs",
    "check": "npm run lint && npm run check:editor && npm run build:editor && npm run build && node scripts/check-render-compat.mjs",
    "serve": "node scripts/serve-reader.mjs",
    "check:reader": "node scripts/check-reader.mjs",
    "build:editor": "node scripts/build-editor.mjs",
    "check:editor": "node --test editor/tests/*.test.mjs",
    "check:editor-browser": "node scripts/check-editor.mjs"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "markdown-it": "14.3.3",
    "prismjs": "1.30.0"
  },
  "overrides": {
    "markdown-it": "$markdown-it",
    "katex": "^0.19.0"
  },
  "license": "MIT",
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.63.0",
    "markdownlint": "0.38.0"
  }
}
