{
  "$schema": "../publisher/node_modules/wrangler/config-schema.json",
  "name": "limen-editor",
  "account_id": "758576157d0685fa4eb2aeaf16781577",
  "main": "worker.mjs",
  "compatibility_date": "2026-03-27",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{"pattern":"limen-editor.vaquum.fi","custom_domain":true}],
  "vars": {"EDITOR_ORIGIN":"https://limen-editor.vaquum.fi"},
  "assets": {"directory":"../editor-build","binding":"ASSETS","run_worker_first":true,"html_handling":"auto-trailing-slash"},
  "durable_objects": {"bindings":[{"name":"EDITOR_STATE","class_name":"EditorState"}]},
  "migrations": [{"tag":"v1","new_sqlite_classes":["EditorState"]}],
  "env": {
    "staging": {
      "name":"limen-editor-staging",
      "routes":[{"pattern":"limen-editor-staging.vaquum.fi","custom_domain":true}],
      "vars":{"EDITOR_ORIGIN":"https://limen-editor-staging.vaquum.fi"},
      "durable_objects":{"bindings":[{"name":"EDITOR_STATE","class_name":"EditorState"}]}
    }
  }
}
