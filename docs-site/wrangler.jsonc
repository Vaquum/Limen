{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "limen-docs",
  "main": "./src/worker.js",
  "compatibility_date": "2026-03-27",
  "assets": {
    "directory": "./build",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
