{
  "rules": [
    {
      "kind": "Required",
      "path": "schema_version",
      "when": "always",
      "type": "str"
    },
    {
      "kind": "Required",
      "path": "metadata",
      "when": "always",
      "type": "dict"
    },
    {
      "kind": "Required",
      "path": "sfd",
      "when": "always",
      "type": "dict"
    },
    {
      "kind": "Required",
      "path": "uel",
      "when": "always",
      "type": "dict"
    },
    {
      "kind": "Required",
      "path": "metadata.name",
      "when": "always",
      "type": "str"
    },
    {
      "kind": "Required",
      "path": "metadata.mode",
      "when": "always",
      "type": "str"
    },
    {
      "kind": "OneOf",
      "path": "metadata.mode",
      "when": "always",
      "choices": [
        "development",
        "production"
      ]
    },
    {
      "kind": "NoUnknownKeys",
      "path": "metadata",
      "when": "always",
      "known": [
        "author",
        "created_at",
        "description",
        "limen_version",
        "mode",
        "name",
        "tags"
      ],
      "severity": "warning"
    },
    {
      "kind": "Required",
      "path": "sfd.manifest",
      "when": "always",
      "type": "dict"
    },
    {
      "kind": "Required",
      "path": "sfd.params",
      "when": "always",
      "type": "dict"
    },
    {
      "kind": "Required",
      "path": "sfd.manifest.type",
      "when": "always",
      "type": "str"
    },
    {
      "kind": "OneOf",
      "path": "sfd.manifest.type",
      "when": "always",
      "choices": [
        "ml",
        "rule_based"
      ]
    },
    {
      "kind": "NoUnknownKeys",
      "path": "sfd.manifest.data_source",
      "when": "always",
      "known": [
        "method",
        "params"
      ],
      "severity": "warning"
    },
    {
      "kind": "NoUnknownKeys",
      "path": "sfd.manifest.split_dates",
      "when": "always",
      "known": [
        "test_end",
        "test_predict_guard",
        "test_start",
        "train_end",
        "train_start",
        "val_end",
        "val_predict_guard",
        "val_start"
      ],
      "severity": "error"
    },
    {
      "kind": "Required",
      "path": "sfd.manifest.reference_architecture",
      "when": "always",
      "type": "str"
    },
    {
      "kind": "Resolvable",
      "path": "sfd.manifest.reference_architecture",
      "when": "always"
    },
    {
      "kind": "NoUnknownKeys",
      "path": "sfd.manifest.backtest",
      "when": "always",
      "known": [
        "barrier_features",
        "execution_data_source",
        "execution_lag_seconds",
        "fee_bps",
        "flat_threshold",
        "funding",
        "initial_equity",
        "max_exposure",
        "max_holding_seconds",
        "max_price_gap_seconds",
        "notional_rate",
        "prediction_mode",
        "product",
        "signal_change_bps",
        "slip_bps",
        "source_interval_seconds",
        "source_timestamp_role",
        "stop_loss_bps",
        "stop_loss_bps_column",
        "take_profit_bps",
        "take_profit_bps_column",
        "timer_interval_seconds",
        "timer_phase_utc_seconds"
      ],
      "severity": "error"
    },
    {
      "kind": "Required",
      "path": "sfd.manifest.target",
      "when": "sfd.manifest.type = ml",
      "type": "dict"
    },
    {
      "kind": "Required",
      "path": "sfd.manifest.target.name",
      "when": "sfd.manifest.type = ml",
      "type": "str"
    },
    {
      "kind": "Required",
      "path": "sfd.manifest.target.class",
      "when": "sfd.manifest.type = ml",
      "type": "str"
    },
    {
      "kind": "Resolvable",
      "path": "sfd.manifest.target.class",
      "when": "sfd.manifest.type = ml"
    },
    {
      "kind": "NoUnknownKeys",
      "path": "sfd.manifest.target",
      "when": "sfd.manifest.type = ml",
      "known": [
        "class",
        "fit_params",
        "name",
        "transform_params"
      ],
      "severity": "error"
    },
    {
      "kind": "FuncList",
      "path": "sfd.manifest.indicators",
      "when": "sfd.manifest.type = ml"
    },
    {
      "kind": "FuncList",
      "path": "sfd.manifest.features",
      "when": "sfd.manifest.type = ml"
    },
    {
      "kind": "SingleFuncBlock",
      "path": "sfd.manifest.pre_split_data_selector",
      "when": "sfd.manifest.type = ml"
    },
    {
      "kind": "SingleFuncBlock",
      "path": "sfd.manifest.bar_formation",
      "when": "sfd.manifest.type = ml"
    },
    {
      "kind": "SingleFuncBlock",
      "path": "sfd.manifest.data_dict_extension",
      "when": "sfd.manifest.type = ml"
    },
    {
      "kind": "NoUnknownKeys",
      "path": "sfd.manifest.data_dict_extension",
      "when": "sfd.manifest.type = ml",
      "known": [
        "func"
      ],
      "severity": "error"
    },
    {
      "kind": "NoUnknownKeys",
      "path": "sfd.manifest.scaler",
      "when": "sfd.manifest.type = ml",
      "known": [
        "class",
        "from_params"
      ],
      "severity": "warning"
    },
    {
      "kind": "NoUnknownKeys",
      "path": "sfd.manifest.feature_ablation",
      "when": "sfd.manifest.type = ml",
      "known": [
        "drop_count_key",
        "seed_key"
      ],
      "severity": "warning"
    },
    {
      "kind": "ParamKeyFields",
      "path": "sfd.manifest.feature_ablation",
      "when": "sfd.manifest.type = ml",
      "fields": [
        "drop_count_key",
        "seed_key"
      ]
    },
    {
      "kind": "NoUnknownKeys",
      "path": "sfd.manifest.pca_compression",
      "when": "sfd.manifest.type = ml",
      "known": [
        "component_prefix",
        "enabled_param",
        "n_components_param",
        "scaler_param_name"
      ],
      "severity": "error"
    },
    {
      "kind": "ParamKeyFields",
      "path": "sfd.manifest.pca_compression",
      "when": "sfd.manifest.type = ml",
      "fields": [
        "component_prefix",
        "enabled_param",
        "n_components_param",
        "scaler_param_name"
      ]
    },
    {
      "kind": "NoUnknownKeys",
      "path": "sfd.manifest.calibration",
      "when": "sfd.manifest.type = ml",
      "known": [
        "probability_calibration",
        "threshold_function"
      ],
      "severity": "warning"
    },
    {
      "kind": "NoUnknownKeys",
      "path": "sfd.manifest.calibration.probability_calibration",
      "when": "sfd.manifest.type = ml",
      "known": [
        "func",
        "params"
      ],
      "severity": "warning"
    },
    {
      "kind": "NoUnknownKeys",
      "path": "sfd.manifest.calibration.threshold_function",
      "when": "sfd.manifest.type = ml",
      "known": [
        "func",
        "params"
      ],
      "severity": "warning"
    },
    {
      "kind": "NoUnknownKeys",
      "path": "sfd.manifest",
      "when": "sfd.manifest.type = ml",
      "known": [
        "acceptance",
        "allocation",
        "backtest",
        "bar_formation",
        "calibration",
        "data_dict_extension",
        "data_source",
        "decoder_lookback",
        "feature_ablation",
        "feature_shims",
        "features",
        "indicators",
        "metrics_params",
        "objective",
        "params_override",
        "pca_compression",
        "pre_split_data_selector",
        "reference_architecture",
        "required_columns",
        "scaler",
        "split_dates",
        "split_walk_forward",
        "strict_mode",
        "target",
        "type"
      ],
      "severity": "warning"
    },
    {
      "kind": "Required",
      "path": "sfd.manifest.strategy",
      "when": "sfd.manifest.type = rule_based",
      "type": "dict"
    },
    {
      "kind": "Required",
      "path": "sfd.manifest.strategy.conditions",
      "when": "sfd.manifest.type = rule_based",
      "type": "list"
    },
    {
      "kind": "Required",
      "path": "sfd.manifest.strategy.entry",
      "when": "sfd.manifest.type = rule_based",
      "type": "str"
    },
    {
      "kind": "FuncList",
      "path": "sfd.manifest.indicators",
      "when": "sfd.manifest.type = rule_based"
    },
    {
      "kind": "NoUnknownKeys",
      "path": "sfd.manifest.strategy",
      "when": "sfd.manifest.type = rule_based",
      "known": [
        "conditions",
        "entry"
      ],
      "severity": "warning"
    },
    {
      "kind": "NoUnknownKeys",
      "path": "sfd.manifest",
      "when": "sfd.manifest.type = rule_based",
      "known": [
        "acceptance",
        "allocation",
        "backtest",
        "data_source",
        "indicators",
        "objective",
        "reference_architecture",
        "required_columns",
        "split_dates",
        "split_walk_forward",
        "strategy",
        "type"
      ],
      "severity": "warning"
    },
    {
      "kind": "Required",
      "path": "uel.n_permutations",
      "when": "always",
      "type": "int"
    },
    {
      "kind": "OneOf",
      "path": "uel.search_strategy.type",
      "when": "always",
      "choices": [
        "grid",
        "random",
        "sobol"
      ]
    },
    {
      "kind": "NoUnknownKeys",
      "path": "uel.search_strategy",
      "when": "always",
      "known": [
        "seed",
        "shuffle",
        "type"
      ],
      "severity": "warning"
    },
    {
      "kind": "OneOf",
      "path": "uel.output_format",
      "when": "always",
      "choices": [
        "csv",
        "parquet"
      ]
    },
    {
      "kind": "NoUnknownKeys",
      "path": "uel",
      "when": "always",
      "known": [
        "checkpoint_interval",
        "factorize",
        "feedback_interval",
        "intra_callback",
        "n_permutations",
        "output_format",
        "output_path",
        "prep_each_round",
        "pruning_strategies",
        "record_execution",
        "record_model_outputs",
        "recording",
        "search_strategy",
        "workers"
      ],
      "severity": "warning"
    }
  ],
