{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Limen documentation evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mode",
    "revision",
    "package",
    "environment",
    "inputs",
    "sources",
    "displays",
    "validation",
    "publication",
    "bundle",
    "native_outputs"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "mode": {
      "enum": [
        "candidate",
        "production",
        "local"
      ]
    },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "head",
        "tested_commit",
        "tree",
        "dirty"
      ],
      "properties": {
        "head": {
          "type": "string",
          "minLength": 1
        },
        "tested_commit": {
          "type": "string",
          "minLength": 1
        },
        "tree": {
          "type": "string",
          "minLength": 1
        },
        "dirty": {
          "type": "boolean"
        }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "wheel_sha256",
        "import_location"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "wheel_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "import_location": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "python",
        "platform",
        "runner",
        "lock_sha256",
        "lock_resolution_target",
        "dependencies_sha256",
        "build_lock_sha256",
        "wheelhouse_manifest_sha256"
      ],
      "properties": {
        "python": {
          "type": "string",
          "minLength": 1
        },
        "platform": {
          "type": "string",
          "minLength": 1
        },
        "runner": {
          "type": "string",
          "minLength": 1
        },
        "lock_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "lock_resolution_target": {
          "type": "string",
          "minLength": 1
        },
        "dependencies_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "build_lock_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "wheelhouse_manifest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "window"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "window": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "region",
          "sha256",
          "commit",
          "status",
          "merged_pr"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "region": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "commit": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "candidate",
              "merged",
              "unavailable"
            ]
          },
          "merged_pr": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "displays": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "scenario",
          "path",
          "sha256",
          "source_sha256",
          "environment_sha256",
          "retained_commit",
          "metrics"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "scenario": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "source_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "environment_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "retained_commit": {
            "type": "string",
            "minLength": 1
          },
          "metrics": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "absolute_tolerance",
                "relative_tolerance"
              ],
              "properties": {
                "absolute_tolerance": {
                  "type": "number",
                  "minimum": 0
                },
                "relative_tolerance": {
                  "type": "number",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "catalogue_sha256",
        "status",
        "scenarios"
      ],
      "properties": {
        "catalogue_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "status": {
          "const": "passed"
        },
        "scenarios": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "interface",
              "command",
              "tests",
              "assertions",
              "output_path",
              "output_sha256",
              "status"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "interface": {
                "enum": [
                  "python",
                  "compiled"
                ]
              },
              "command": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "tests": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "assertions": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "output_path": {
                "type": "string",
                "minLength": 1
              },
              "output_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "status": {
                "const": "passed"
              }
            }
          }
        }
      }
    },
    "publication": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "release",
            "merged_commit",
            "released_wheel_sha256",
            "bundle_sha256",
            "site_sha256",
            "validation_sha256"
          ],
          "properties": {
            "release": {
              "type": "string",
              "minLength": 1
            },
            "merged_commit": {
              "type": "string",
              "minLength": 1
            },
            "released_wheel_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "bundle_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "site_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "validation_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      ]
    },
    "bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "native_outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
