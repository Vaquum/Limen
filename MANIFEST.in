include CONTRIBUTING.md
include GOVERNANCE.md
include MAINTAINERS.md
include NOTICE
include SECURITY.md
include SUPPORT.md
include THIRD_PARTY.md
include .markdownlint.json
recursive-include docs *.md *.yaml
recursive-include docs/benchmarks *.csv *.json *.txt
include docs/examples/xgboost_sweep.py
include docs-site/CLOUDFLARE.md
include docs-site/package.json
include docs-site/package-lock.json
recursive-include docs-site/scripts *.mjs
recursive-include docs-site/src *.js *.css *.json
