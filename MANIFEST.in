recursive-include tests/fixtures *.parquet *.arrow
prune examples
prune docs-site/node_modules
prune .venv
prune .mypy_cache
prune .pytest_cache
prune .ruff_cache
global-exclude __pycache__ *.py[cod]

recursive-include docs/examples *.py *.json *.txt *.in *.sh *.toml
recursive-include docs/checker/tests *.py
recursive-include docs-site/reader *.mjs *.css *.json
