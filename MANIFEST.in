include README.md
include AGENTS.md
include Claude.md
include Project.md
include limen_build_backend.py
include CHANGELOG.md
include LICENSE
include AUTHORS
include CITATION.cff
include CODE_OF_CONDUCT.md
include CONTRIBUTING.md
include GOVERNANCE.md
include MAINTAINERS.md
include NOTICE
include SECURITY.md
include SUPPORT.md
include THIRD_PARTY.md
include .markdownlint.json
recursive-include docs *.md
include docs-site/CLOUDFLARE.md
include docs-site/docusaurus.config.js
include docs-site/product-docs.json
include docs-site/package.json
include docs-site/package-lock.json
include docs-site/sidebars.js
include docs-site/wrangler.jsonc
include docs-site/docs/.gitkeep
recursive-include docs-site/scripts *.mjs
recursive-include docs-site/src *.js *.css
recursive-include .github *.md *.yml
recursive-include limen *.md
include limen/py.typed
recursive-include limen/yaml/templates *.yaml
recursive-include requirements *.txt
recursive-include scripts *.py
recursive-include tests *.py *.json
recursive-include tests/fixtures *.csv *.zip
prune examples
prune docs-site/.docusaurus
prune docs-site/.generated
prune docs-site/build
prune docs-site/node_modules
prune .venv
prune .mypy_cache
prune .pytest_cache
prune .ruff_cache
global-exclude __pycache__ *.py[cod]
